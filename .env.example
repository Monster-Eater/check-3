# Local development
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# Render production values are configured in render.yaml / Render dashboard.
# Add your Flutter Web host here if the web client is deployed separately.
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-flutter-web-host.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-flutter-web-host.example
# DATABASE_URL=postgresql://...

# Optional S3-compatible storage for persistent uploads (AWS S3, Cloudflare R2, etc.)
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
